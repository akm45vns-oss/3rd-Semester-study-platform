# ==============================================================================
# Semester OS — Backend Production Environment Template
# ==============================================================================

PYTHON_VERSION=3.11.9
APP_NAME="Semester OS"
APP_VERSION="1.0.0"
DEBUG=false

# Cryptographically Secure JWT Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-64-character-hex-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production Database (Supabase PostgreSQL or Neon URI)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Groq 5-Key Multi-Worker Configuration (Get free keys at https://console.groq.com/keys)
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
AI_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...
GROQ_API_KEY_4=gsk_...
GROQ_API_KEY_5=gsk_...

# CORS Allowed Origins
ALLOWED_ORIGINS=["https://3rd-semester-study-platform.vercel.app","https://*.vercel.app","https://*.netlify.app","http://localhost:5173","http://localhost:3000"]
