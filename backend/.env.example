# Semester OS — Backend Environment Configuration

APP_NAME="Semester OS"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite+aiosqlite:///./semester_os.db

# Groq AI Key for Seeding and Dynamic Study Material Generation
# Get a free key at https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
